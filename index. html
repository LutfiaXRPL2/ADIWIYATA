<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Program Adiwiyata Sekolah</title>
    <style>
        * {margin:0; padding:0; box-sizing:border-box; font-family:Arial,sans-serif;}
        body {background:#f0f8f0; line-height:1.6;}
        header {background:#2e7d32; color:white; text-align:center; padding:1.5rem;}
        .container {max-width:1200px; margin:2rem auto; padding:0 1rem;}
        .card {background:white; border-radius:8px; padding:1.5rem; margin-bottom:1.5rem; box-shadow:0 2px 5px rgba(0,0,0,.1);}
        h2,h3 {color:#2e7d32; margin-bottom:.8rem;}
        ul {padding-left:1.5rem; margin:1rem 0;}
        input, button {padding:.6rem; border-radius:4px; border:1px solid #ccc; font-size:1rem; margin:.3rem;}
        button {background:#2e7d32; color:white; border:none; cursor:pointer;}
        button:hover {background:#266a29;}
        #hasil {margin-top:1rem; padding:1rem; background:#e8f5e9; border-radius:6px; white-space:pre-wrap;}
        footer {background:#2e7d32; color:white; text-align:center; padding:1rem; margin-top:2rem;}
    </style>
</head>
<body>
    <header>
        <h1>🌿 Program Adiwiyata Sekolah</h1>
        <p>Sekolah Peduli Lingkungan dan Berkelanjutan</p>
    </header>

    <div class="container">
        <div class="card">
            <h2>Tentang Adiwiyata</h2>
            <p>Adiwiyata adalah program pemerintah Indonesia yang bertujuan menciptakan lingkungan sekolah yang sehat, bersih, dan berkelanjutan.</p>
        </div>

        <div class="card">
            <h2>Kegiatan Utama</h2>
            <ul>
                <li>🌳 Penanaman pohon & penghijauan</li>
                <li>🗑️ Pemilahan & pengelolaan sampah</li>
                <li>💡 Hemat energi & air</li>
                <li>📚 Pendidikan lingkungan hidup</li>
                <li>🤝 Kerjasama dengan komunitas lingkungan</li>
            </ul>
        </div>

        <div class="card">
            <h2>Kalkulator Pengurangan Sampah</h2>
            <label>Jumlah Bulan: </label>
            <input type="number" id="bulan" value="6" min="1">
            <button onclick="hitung()">Hitung</button>
            <div id="hasil"></div>
        </div>
    </div>

    <footer>
        <p>&copy; 2026 Sekolah Adiwiyata — Semua Hak Dilindungi</p>
    </footer>

    <script>
        const data = [
            {nama:"Pemilahan Sampah Organik", kg:50},
            {nama:"Pengurangan Plastik", kg:30},
            {nama:"Daur Ulang Kertas", kg:20},
            {nama:"Pengomposan", kg:40}
        ];

        function hitung() {
            const bulan = parseInt(document.getElementById("bulan").value);
            let teks = `📊 Laporan Pengurangan Sampah (${bulan} Bulan)\n`;
            teks += "=".repeat(50) + "\n";
            let total = 0;
            data.forEach(k => {
                const jml = k.kg * bulan;
                total += jml;
                teks += `✅ ${k.nama}: ${jml} kg\n`;
            });
            teks += "=".repeat(50) + "\n";
            teks += `📦 Total: ${total} kg\n🌿 Terima kasih menjaga lingkungan!`;
            document.getElementById("hasil").textContent = teks;
        }
    </script>
</body>
</html>
